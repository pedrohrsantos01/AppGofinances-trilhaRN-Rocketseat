{
  "name": "gofinances",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "api:dev": "tsx watch apps/api/src/server.ts",
    "api:start": "tsx apps/api/src/server.ts",
    "test": "jest",
    "test:api": "jest --testPathPattern='apps/api'",
    "test:unit": "jest --testPathPattern='__tests__/unit'",
    "test:integration": "jest --testPathPattern='__tests__/integration'",
    "test:coverage": "jest --coverage",
    "test:coverage:ci": "jest --coverage --ci",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "detox test --configuration android.debug",
    "test:e2e:smoke": "detox test --configuration android.debug e2e/smoke/auth.test.ts --cleanup",
    "test:e2e:build": "detox build --configuration android.debug"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/sensible": "^6.0.4",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@supabase/supabase-js": "^2.99.0",
    "date-fns": "^2.30.0",
    "expo": "~55.0.4",
    "expo-apple-authentication": "~55.0.8",
    "expo-auth-session": "~55.0.6",
    "expo-document-picker": "~55.0.8",
    "expo-file-system": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-linear-gradient": "~55.0.8",
    "expo-notifications": "~55.0.11",
    "expo-sharing": "~55.0.11",
    "expo-splash-screen": "~55.0.10",
    "expo-sqlite": "~15.1.3",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "expo-web-browser": "~55.0.9",
    "fastify": "^5.8.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.71.2",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-responsive-fontsize": "^0.5.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-uuid": "^2.0.3",
    "react-native-web": "^0.21.0",
    "styled-components": "^6.1.19",
    "tsx": "^4.21.0",
    "victory-native": "^36.9.2",
    "yup": "^0.32.11",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.9.0",
    "@types/detox": "^18.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "detox": "^20.33.1",
    "eslint": "^9.22.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^10.1.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.5",
    "lint-staged": "^16.0.0",
    "msw": "^2.7.3",
    "prettier": "^3.5.3",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "private": true
}
